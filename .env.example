DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sanctions
DB_USER=root
DB_PASSWORD=

# Connection pool (raise max_open under concurrent screening load)
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME_MIN=5
DB_READ_TIMEOUT_SEC=30
DB_WRITE_TIMEOUT_SEC=30

SERVER_PORT=8080
API_KEY=your-secret-api-key
SANCTIONS_JSON_PATH=/path/to/sanctions.json

# Use slow LIKE '%token%' only when ngram index is unavailable (default: false)
SCREEN_USE_LIKE_FALLBACK=false

# Run the candidate scorer alongside the live one and report both. Observation
# only: does not change which records are returned or how they are ranked.
SCREEN_SHADOW_SCORING=false

# Optional CPU/memory profiling on :6060 (do not expose publicly)
ENABLE_PPROF=false
